{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bounded SDK ISA and memory resource requirements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "hart": {
      "type": "integer",
      "minimum": 0
    },
    "isa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "xlen": {
          "enum": [
            32,
            64
          ]
        },
        "extensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*$"
          }
        },
        "vlen_min_bits": {
          "type": "integer",
          "minimum": 1
        },
        "vlen_bits": {
          "type": "integer",
          "minimum": 1
        },
        "custom_contracts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "versions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "min": {
                "type": "string",
                "pattern": "^[0-9]+([.p][0-9]+)?$"
              },
              "max": {
                "type": "string",
                "pattern": "^[0-9]+([.p][0-9]+)?$"
              }
            }
          }
        }
      }
    },
    "memory": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "owner",
          "clients",
          "permissions",
          "min_bytes",
          "alignment"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "ram",
              "tcm"
            ]
          },
          "owner": {
            "enum": [
              "shared",
              "executing_hart"
            ]
          },
          "clients": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(instruction|scalar-data|rvv|cute|rocc-[0-9]+)$"
            }
          },
          "permissions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "read",
                "write",
                "execute",
                "cacheable",
                "atomic"
              ]
            }
          },
          "min_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "alignment": {
            "type": "integer",
            "minimum": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "tcm"
                }
              }
            },
            "then": {
              "properties": {
                "owner": {
                  "const": "executing_hart"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "ram"
                }
              }
            },
            "then": {
              "properties": {
                "owner": {
                  "const": "shared"
                }
              }
            }
          }
        ]
      }
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "devices": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "permissions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "kind": {
            "enum": [
              "mmio",
              "rom"
            ]
          },
          "permissions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "read",
                "write",
                "execute"
              ]
            }
          },
          "min_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "compatible": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
