{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "type":"object", "additionalProperties":false,
  "required":["version","id","abi","boot_io","stack_bytes","heap_bytes","qemu_backend","coverage"],
  "properties": {
    "version":{"const":1}, "id":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"},
    "abi":{"enum":["lp64","lp64f","lp64d"]}, "boot_io":{"const":"htif"},
    "stack_bytes":{"type":"integer","minimum":4096},
    "heap_bytes":{"type":"integer","minimum":0},
    "qemu_backend":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"},
    "coverage":{"enum":["workload","full-target"]}
  }
}
