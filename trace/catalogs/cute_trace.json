      "fields": [
        {
          "name": "macro_id",
          "type": "uint",
          "fmt": "dec"
        },
        {
          "name": "opcode",
          "type": "uint",
          "fmt": "hex"
        }
      ],
      "render": "macro_id={macro_id} opcode=0x{opcode:x}"
    },
