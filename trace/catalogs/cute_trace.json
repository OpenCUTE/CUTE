{
  "version": 1,
  "catalog_id": "cute_trace_v1",
  "description": "CUTETrace 的种子 catalog。Phase 0.6 从 cute_inst 和 cute_task trace 事件开始，并补齐 CML/Vector store trace 的外围事件。",
  "categories": [
    {
      "name": "cute_inst",
      "id": 0,
      "description": "发往 CUTE 的指令、完成、程序退出相关观测。"
    },
    {
      "name": "cute_task",
      "id": 1,
      "description": "CUTE 内部 task 的 issue、start、end、commit 生命周期。"
    },
    {
      "name": "cute_loadstore",
      "id": 2,
      "description": "CUTE 内部 load 读取和 store 写回的观测。"
    },
    {
      "name": "cute_compute",
      "id": 3,
      "description": "MTE 计算输入、输出和结果的观测。"
    },
    {
      "name": "vector_loadstore",
      "id": 4,
      "description": "vector 与 CUTE 配合时的访存观测。"
    },
    {
      "name": "system_memory",
      "id": 5,
      "description": "Client request/response handshakes for ack-based system verification."
    },
    {
      "name": "system_control",
      "id": 6,
      "description": "Software checkpoints with acknowledged RoCC markers."
    }
  ],
  "modules": [
    {
      "name": "TaskController",
      "id": 1,
      "description": "CUTE 宏指令/微指令调度与生命周期管理模块。"
    },
    {
      "name": "AML",
      "id": 2,
      "description": "A 张量加载模块。"
    },
    {
      "name": "BML",
      "id": 3,
      "description": "B 张量加载模块。"
    },
    {
      "name": "CML",
      "id": 4,
      "description": "C/D 张量加载与 store 写回模块。"
    },
    {
      "name": "MTE",
      "id": 5,
      "description": "矩阵张量计算引擎。"
    },
    {
      "name": "LocalMMU",
      "id": 6,
      "description": "CUTE 本地 MMU 与内存请求路由模块。"
    },
    {
      "name": "Vector",
      "id": 7,
      "description": "Vector 单元与 CUTE 配合时的访存观测模块。"
    },
    {
      "name": "SystemTrace",
      "id": 8,
      "description": "System verification observation boundaries."
    }
  ],
  "tasks": [
    {
      "name": "TaskControllerTrace",
      "id": 1,
      "module": "TaskController",
      "method_group": "TaskControllerTrace",
      "description": "TaskController 的宏/微任务生命周期 trace 组。"
